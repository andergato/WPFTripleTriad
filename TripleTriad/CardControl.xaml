<UserControl x:Class="TripleTriad.CardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TripleTriad"
             mc:Ignorable="d" 
             Width="90" Height="90"
             MouseMove="CardControl_MouseMove">
    <Viewbox>
        <Grid>
            <Rectangle x:Name="DragCard" Fill="blue" 
               Width="90" Height="90"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"/>
            <TextBlock x:Name = "TopNumber" Margin="0,2,0,0" Height="15" Width="15" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="12" TextAlignment="Center"/>
            <TextBlock x:Name = "LeftNumber" Margin="2,0,0,0" Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="12" TextAlignment="Center"/>
            <TextBlock x:Name = "BottomNumber" Margin="0,0,0,2" Height="15" Width="15" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="12" TextAlignment="Center"/>
            <TextBlock x:Name = "RightNumber" Margin="0,0,2,0" Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" TextAlignment="Center"/>
        </Grid>
    </Viewbox>
</UserControl>