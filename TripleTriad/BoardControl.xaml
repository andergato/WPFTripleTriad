<UserControl x:Class="TripleTriad.BoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TripleTriad"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Viewbox Margin="100">
    <Grid x:Name="LayoutRoot" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="LightBlue" Margin="2" AllowDrop="True" Drop="Border_Drop"/>
        <Border Grid.Row="0" Grid.Column="1" Background="LightCoral"  Margin="2" AllowDrop="True" Drop="Border_Drop"/>
        <Border Grid.Row="0" Grid.Column="2" Background="LightGreen"  Margin="2" AllowDrop="True" Drop="Border_Drop"/>
        <Border Grid.Row="1" Grid.Column="0" Background="LightBlue"   Margin="2" AllowDrop="True" Drop="Border_Drop"/>
        <Border Grid.Row="1" Grid.Column="1" Background="LightCoral"  Margin="2" AllowDrop="True" Drop="Border_Drop"/>
        <Border Grid.Row="1" Grid.Column="2" Background="LightGreen"  Margin="2" AllowDrop="True" Drop="Border_Drop"/>
        <Border Grid.Row="2" Grid.Column="0" Background="LightBlue"   Margin="2" AllowDrop="True" Drop="Border_Drop"/>
        <Border Grid.Row="2" Grid.Column="1" Background="LightCoral"  Margin="2" AllowDrop="True" Drop="Border_Drop"/>
        <Border Grid.Row="2" Grid.Column="2" Background="LightGreen"  Margin="2" AllowDrop="True" Drop="Border_Drop"/>
    </Grid>
    </Viewbox>
</UserControl>
